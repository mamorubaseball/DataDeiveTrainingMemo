{
  "expo": {
    "name": "DataDeiveTrainingMemo",
    "slug": "data-driven-training-memo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "datadriventrainingmemo",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.mamorubaseball.datadriventrainingmemo",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSHealthShareUsageDescription": "今週のトレーニング時間や平均心拍数、消費カロリーをヘルスケアから取得し、グラフおよび分析に反映するために使用します。",
        "NSHealthUpdateUsageDescription": "アプリ内のトレーニングログをヘルスケアに記録するために使用します。"
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mamorubaseball.datadriventrainingmemo"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-image-picker",
        {
          "photosPermission": "SNSでシェアする画像に筋トレ写真を合成するために、写真ライブラリへのアクセスを使用します。"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
